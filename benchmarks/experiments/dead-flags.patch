+/// Look through nonfaulting flag-transparent instructions only. The caller
+/// bounds this iterator to the current segment and cooperative checkpoint.
+pub(crate) fn emit_overwritten_flags_after<'a>(
+    insn: &Insn,
+    following: impl Iterator<Item = &'a Insn>,
+) -> Option<Seq> {
+    if !pure_full_width_alu(insn) {
+        return None;
+    }
+    use crate::x86::types::Mnem::*;
+    for next in following {
+        let registers_only = next
+            .ops
+            .iter()
+            .all(|op| matches!(op, Operand::Reg { .. } | Operand::Imm(_)));
+        let transparent = match next.mnem {
+            Nop | Cwde | Cdq => true,
+            Mov | Movsx | Movzx | Xchg | Not | Bswap => registers_only,
+            Lea => matches!(next.ops.first(), Some(Operand::Reg { size: 4, .. })),
+            _ => false,
+        };
+        if !transparent {
+            return emit_overwritten_flags(insn, next);
+        }
+    }
+    None
+}
