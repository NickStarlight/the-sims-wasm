+#[test]
+fn previous_color_copy_preserves_overlap_faults_registers_and_checkpoints() {
+    use crate::translate::{layout::NEXT, scheduling::CHECKPOINT_BUDGET_GLOBAL};
+    let functions = HashMap::new();
+    let imports = HashMap::new();
+    let context = crate::translate::emit::EmitCtx {
+        memory_minimum_pages: 1,
+        id: BTreeMap::new(),
+        func_idx_of: &functions,
+        idx_of: 0,
+        iat_shim: &imports,
+        block_trace: None,
+    };
+    let mut routines = Vec::new();
+    for (address, modrm, plain, span) in [
+        (0x49890f, 0x01, "plain", "span"),
+        (0x4989dc, 0x08, "plain_masked", "span_masked"),
+    ] {
+        // MOV DX,[EAX+ECX]; MOV [EAX],DX; INC EAX twice; CMP EAX,end.
+        let bytes = [
+            0x66, 0x8b, 0x14, modrm, 0x66, 0x89, 0x10, 0x40, 0x40, 0x3d, 0x4c, 0x5d, 0x6e, 0,
+        ];
+        let mut memory = GuestMem::new();
+        memory.write(0, &bytes);
+        let mut decoded = Vec::new();
+        let mut at = 0;
+        while at < bytes.len() as u32 {
+            let mut insn = decode_insn(&memory, 0, at).unwrap();
+            at += insn.size;
+            insn.va += address;
+            decoded.push(insn);
+        }
+        for (name, optimized) in [(plain, false), (span, true)] {
+            let mut code = i32c(0);
+            code.extend(local_set(NEXT));
+            code.extend([Op::BLOCK, 0x40, Op::LOOP, 0x40]);
+            code.extend(local_get(NEXT));
+            code.extend([Op::BR_IF, 1]);
+            code.extend(set_reg(abi::TRAP_VA, i32c(address as i32)));
+            code.extend(set_reg(
+                CHECKPOINT_BUDGET_GLOBAL,
+                binary(reg(CHECKPOINT_BUDGET_GLOBAL), i32c(1), Op::I32_SUB),
+            ));
+            code.extend(reg(CHECKPOINT_BUDGET_GLOBAL));
+            code.extend([Op::I32_EQZ, Op::IF, 0x40]);
+            code.extend(set_reg(CHECKPOINT_BUDGET_GLOBAL, i32c(256)));
+            code.extend([Op::CALL, 0, Op::END]);
+            if optimized {
+                code.extend(copy_previous(1, 0, true));
+            }
+            for insn in &decoded {
+                code.extend(emit_insn(insn, &context, -1, 0).unwrap());
+            }
+            code.extend(binary(reg(abi::EAX), i32c(PREVIOUS + 64), Op::I32_LT_S));
+            code.extend([Op::BR_IF, 0, Op::END, Op::END]);
+            routines.push((name, crate::translate::optimize::promote(&code).0));
+        }
+    }
+    routines.push((
+        "set_budget",
+        set_reg(CHECKPOINT_BUDGET_GLOBAL, reg(abi::EDX)),
+    ));
+    routines.push((
+        "read_budget",
+        set_reg(abi::EDX, reg(CHECKPOINT_BUDGET_GLOBAL)),
+    ));
+    execute_sequences_v8(
+        &routines,
+        include_str!("../../../fixtures/compositor-alpha-copy.mjs"),
+    );
+}
