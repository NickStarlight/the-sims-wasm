+/// Copy the remaining words in the previous-color row. Keep the native forward
+/// load/store order even for overlap: memcpy/memmove semantics are not equivalent.
+/// Validate the entire span before suppressing its per-word flags/checkpoints.
+fn copy_previous(successor: i32, depth: i32, checkpointed: bool) -> Seq {
+    let mut code = vec![Op::BLOCK, 0x40];
+    let guard = |code: &mut Seq, condition: Seq| {
+        code.extend(condition);
+        code.extend([Op::I32_EQZ, Op::BR_IF, 0]);
+    };
+    guard(
+        &mut code,
+        binary(reg(abi::EAX), i32c(PREVIOUS), Op::I32_GE_U),
+    );
+    guard(
+        &mut code,
+        binary(reg(abi::EAX), i32c(PREVIOUS + 64), Op::I32_LT_U),
+    );
+    guard(
+        &mut code,
+        binary(reg(abi::EAX), i32c(1), Op::I32_AND)
+            .into_iter()
+            .chain([Op::I32_EQZ])
+            .collect(),
+    );
+    code.extend(binary(i32c(PREVIOUS + 64), reg(abi::EAX), Op::I32_SUB));
+    code.extend(local_set(COUNT)); // remaining byte count
+    cache_bounds(&mut code);
+    guard(&mut code, within(i32c(PREVIOUS), 64));
+    code.extend(binary(reg(abi::EAX), reg(abi::ECX), Op::I32_ADD));
+    code.extend(local_set(SOURCE_POINTER));
+    guard(
+        &mut code,
+        within_length(local_get(SOURCE_POINTER), extend(local_get(COUNT))),
+    );
+    code.extend(binary(local_get(COUNT), i32c(1), Op::I32_SHR_U));
+    code.extend(local_set(COUNT)); // one original block visit per word
+    if checkpointed {
+        guard(
+            &mut code,
+            binary(
+                local_get(COUNT),
+                reg(crate::translate::scheduling::CHECKPOINT_BUDGET_GLOBAL),
+                Op::I32_LE_U,
+            ),
+        );
+    }
+    code.extend(reg(abi::EAX));
+    code.extend(local_set(DESTINATION));
+    code.extend([Op::LOOP, 0x40]);
+    code.extend(load(local_get(SOURCE_POINTER), Op::I32_LOAD16_U, 1));
+    code.extend(local_set(T3));
+    code.extend(local_get(DESTINATION));
+    code.extend(local_get(T3));
+    code.extend([Op::I32_STORE16, 1, 0]);
+    for local in [SOURCE_POINTER, DESTINATION] {
+        code.extend(binary(local_get(local), i32c(2), Op::I32_ADD));
+        code.extend(local_set(local));
+    }
+    code.extend(binary(
+        local_get(DESTINATION),
+        i32c(PREVIOUS + 64),
+        Op::I32_LT_U,
+    ));
+    code.extend([Op::BR_IF, 0, Op::END]);
+    code.extend(set_reg(
+        abi::EDX,
+        binary(
+            binary(reg(abi::EDX), i32c(-65536), Op::I32_AND),
+            local_get(T3),
+            Op::I32_OR,
+        ),
+    ));
+    code.extend(set_reg(abi::EAX, i32c(PREVIOUS + 64)));
+    code.extend(set_reg(abi::FLAGS, i32c(abi::ZF | abi::PF)));
+    if checkpointed {
+        code.extend(set_reg(
+            crate::translate::scheduling::CHECKPOINT_BUDGET_GLOBAL,
+            binary(
+                reg(crate::translate::scheduling::CHECKPOINT_BUDGET_GLOBAL),
+                binary(local_get(COUNT), i32c(1), Op::I32_SUB),
+                Op::I32_SUB,
+            ),
+        ));
+    }
+    code.extend(i32c(successor));
+    code.extend(local_set(crate::translate::layout::NEXT));
+    code.push(Op::BR);
+    code.extend(crate::wasm::leb::uleb(depth as u32 + 1));
+    code.push(Op::END);
+    code
+}
