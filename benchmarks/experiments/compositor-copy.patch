@@ -0,0 +1,152 @@
+import assert from 'node:assert/strict'
+import { readFileSync, writeFileSync } from 'node:fs'
+import { createHash } from 'node:crypto'
+const names = [
+  'eax',
+  'ecx',
+  'edx',
+  'ebx',
+  'esp',
+  'ebp',
+  'esi',
+  'edi',
+  'flags',
+  'fp_top',
+  'fp_status',
+  'trap_va',
+  'call_target',
+  'resume_next',
+  'actual_return',
+  'teb_base',
+]
+const memory = new WebAssembly.Memory({ initial: 128 })
+const bytes = new Uint8Array(memory.buffer)
+const previous = 0x6e5d0c
+let traces, mutation
+const snapshot = () => ({
+  registers: names.map((n) => env[n].value),
+  memory: createHash('sha256').update(bytes).digest('hex'),
+})
+const env = {
+  memory,
+  observe() {
+    traces.push(snapshot())
+    mutation?.(traces.length)
+  },
+}
+for (const name of names) env[name] = new WebAssembly.Global({ value: 'i32', mutable: true }, 0)
+const module = new WebAssembly.Module(readFileSync(0))
+const { exports: run } = new WebAssembly.Instance(module, { env })
+let seed = 91,
+  cases = 0
+const random = () => (seed = (Math.imul(seed, 1664525) + 1013904223) | 0)
+function compare(options = {}) {
+  const {
+    index = 0,
+    source = 0x30000,
+    budget = 256,
+    change,
+    interrupt,
+    initialPages = 128,
+  } = options
+  const initial = names.map(() => random())
+  function execute(name) {
+    // Limit visible memory for destination-boundary cases via a separate instance.
+    const testMemory =
+      initialPages === 128 ? memory : new WebAssembly.Memory({ initial: initialPages })
+    const testBytes = new Uint8Array(testMemory.buffer)
+    const testView = new DataView(testMemory.buffer)
+    const testEnv = { ...env, memory: testMemory }
+    const state = () => ({
+      registers: names.map((n) => env[n].value),
+      memory: createHash('sha256').update(testBytes).digest('hex'),
+    })
+    testEnv.observe = () => {
+      traces.push(state())
+      mutation?.(traces.length)
+    }
+    const exports =
+      initialPages === 128 ? run : new WebAssembly.Instance(module, { env: testEnv }).exports
+    testBytes.fill(0xa5)
+    for (const base of [source, previous - 16])
+      for (let i = 0; i < 48; i++) {
+        const at = base + 2 * i
+        if (at >= 0 && at + 2 <= testBytes.length)
+          testView.setUint16(at, (i * 9173 + base) & 65535, true)
+      }
+    env.edx.value = budget
+    exports.set_budget()
+    names.forEach((n, i) => (env[n].value = initial[i]))
+    env.eax.value = previous + index
+    env.ecx.value = (source - env.eax.value) | 0
+    traces = []
+    mutation = (count) => {
+      if (count !== 1) return
+      if (change === 'source') env.ecx.value = (testBytes.length - env.eax.value) | 0
+      if (change === 'data') testView.setUint16(source + 62, 0x1234, true)
+      if (interrupt) throw Error('checkpoint interrupt')
+    }
+    let error = null
+    try {
+      exports[name]()
+    } catch (e) {
+      error = { name: e.name, message: e.message }
+    }
+    const result = state()
+    exports.read_budget()
+    return { ...result, error, traces, budget: env.edx.value }
+  }
+  for (const [plain, span] of [
+    ['plain', 'span'],
+    ['plain_masked', 'span_masked'],
+  ])
+    assert.deepEqual(execute(span), execute(plain), JSON.stringify(options))
+  cases++
+}
+for (const index of [0, 2, 14, 30, 60, 62])
+  for (const budget of [1, 2, 3, 7, 16, 31, 32, 33, 64, 256]) compare({ index, budget })
+for (const source of [
+  0,
+  bytes.length - 64,
+  bytes.length - 63,
+  bytes.length - 2,
+  bytes.length,
+  0xfffffffe,
+  previous - 2,
+  previous,
+  previous + 1,
+  previous + 2,
+  previous + 30,
+  previous + 63,
+])
+  compare({ source })
+for (const index of [-2, 1, 63, 64, 66]) compare({ index })
+for (const change of ['source', 'data']) compare({ budget: 4, change })
+compare({ budget: 4, interrupt: true })
+compare({ initialPages: 108 })
+console.log(`Previous-color word copy: ${cases * 2} differential cases passed`)
+if (process.env.SIMS_COPY_BENCH_REPORT) {
+  // Explicit opt-in microbenchmark: repeated 32-pixel rows, with normal budgets.
+  // Host callbacks remain active, but omit expensive correctness snapshots here.
+  env.observe = () => {}
+  const fastEnv = { ...env, observe() {} }
+  const fast = new WebAssembly.Instance(module, { env: fastEnv }).exports
+  const iterations = 200000,
+    samples = { plain: [], span: [] }
+  for (let round = 0; round < 7; round++)
+    for (const name of round % 2 ? ['span', 'plain'] : ['plain', 'span']) {
+      env.edx.value = 256
+      fast.set_budget()
+      env.ecx.value = 0x30000 - previous
+      const start = performance.now()
+      for (let i = 0; i < iterations; i++) {
+        env.eax.value = previous
+        fast[name]()
+      }
+      if (round > 0) samples[name].push(performance.now() - start)
+    }
+  writeFileSync(
+    process.env.SIMS_COPY_BENCH_REPORT,
+    JSON.stringify({ iterations, samples }, null, 2),
+  )
+}
